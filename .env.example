# Local-first settings for Data Quality Studio
MODEL_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# For offline/no-model mode: MODEL_PROVIDER=deterministic
# Optional explicit remote provider: MODEL_PROVIDER=huggingface and HF_TOKEN=...
HF_TOKEN=
ENVIRONMENT=local
SESSION_SECRET_KEY=
PRIVATE_SESSION_DIR=private/session_state
MAX_UPLOAD_BYTES=104857600
